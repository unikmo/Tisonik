{
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/enquiry-notifications",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/stays-purge",
      "schedule": "30 3 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.tisonik.com"
        }
      ],
      "destination": "https://tisonik.com/:path*",
      "permanent": true
    },
    {
      "source": "/all-inclusive-resorts",
      "destination": "/hotels/",
      "permanent": true
    },
    {
      "source": "/all-inclusive-resorts/",
      "destination": "/hotels/",
      "permanent": true
    },
    {
      "source": "/all-inclusive-resorts/:path+",
      "destination": "/hotels/:path",
      "permanent": true
    },
    {
      "source": "/hotels",
      "destination": "/hotels/",
      "permanent": true
    },
    {
      "source": "/resort-live-demo",
      "destination": "/resort-live-demo/",
      "permanent": true
    },
    {
      "source": "/resort-pilot",
      "destination": "/resort-pilot/",
      "permanent": true
    },
    {
      "source": "/resort-guest-engagement-software",
      "destination": "/resort-guest-engagement-software/",
      "permanent": true
    },
    {
      "source": "/hotel-service-recovery-software",
      "destination": "/hotel-service-recovery-software/",
      "permanent": true
    },
    {
      "source": "/resort-upselling-software",
      "destination": "/resort-upselling-software/",
      "permanent": true
    },
    {
      "source": "/hotel-ancillary-revenue-software",
      "destination": "/hotel-ancillary-revenue-software/",
      "permanent": true
    },
    {
      "source": "/resort-experience-discovery",
      "destination": "/resort-experience-discovery/",
      "permanent": true
    },
    {
      "source": "/hotel-guest-rating-software",
      "destination": "/hotel-guest-rating-software/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/portal/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://nklnxeobhmnqgfbrvzcg.supabase.co wss://nklnxeobhmnqgfbrvzcg.supabase.co; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/sandbox/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/stay/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-src https://www.youtube-nocookie.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/product-app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    },
    {
      "source": "/product-app/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet, noimageindex"
        }
      ]
    }
  ]
}
